<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================ -->
    <!--  Project Coordinates                                         -->
    <!-- ============================================================ -->
    <groupId>com.ecommerce</groupId>
    <artifactId>ecommerce-test-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>E-Commerce Test Automation Framework</name>
    <description>
        Enterprise Selenium POM Framework for E-Commerce Web Application Testing.
        Covers: Page Factory, Allure Reports, Data-Driven (Excel + JSON),
        WebDriverWait, DriverFactory, Services Layer, TestNG, Parallel Execution.
    </description>

    <!-- ============================================================ -->
    <!--  Global Properties                                           -->
    <!-- ============================================================ -->
    <properties>

        <!-- Java -->
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ── Core Framework ── -->
        <selenium.version>4.18.1</selenium.version>
        <testng.version>7.9.0</testng.version>
        <webdrivermanager.version>5.8.0</webdrivermanager.version>

        <!-- ── Reporting ── -->
        <allure.version>2.26.0</allure.version>
        <allure.maven.version>2.12.0</allure.maven.version>
        <extentreports.version>5.1.1</extentreports.version>

        <!-- ── Data-Driven ── -->
        <apache.poi.version>5.2.5</apache.poi.version>
        <jackson.version>2.17.0</jackson.version>
        <gson.version>2.10.1</gson.version>

        <!-- ── Config ── -->
        <owner.version>1.0.12</owner.version>

        <!-- ── Logging ── -->
        <log4j.version>2.23.1</log4j.version>
        <slf4j.version>2.0.12</slf4j.version>

        <!-- ── Utilities ── -->
        <lombok.version>1.18.32</lombok.version>
        <commons.io.version>2.16.1</commons.io.version>
        <commons.lang3.version>3.14.0</commons.lang3.version>
        <commons.codec.version>1.16.1</commons.codec.version>
        <aspectj.version>1.9.22</aspectj.version>
        <faker.version>1.0.2</faker.version>
        <assertj.version>3.25.3</assertj.version>
        <rest.assured.version>5.4.0</rest.assured.version>

        <!-- ── Plugin Versions ── -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>

        <!-- ── Runtime Switches (override via CLI or CI) ── -->
        <!-- mvn clean test -Dbrowser=firefox -Denv=staging -Dheadless=true -->
        <browser>chrome</browser>
        <env>dev</env>
        <headless>false</headless>
        <thread.count>2</thread.count>
        <suite.file>testng.xml</suite.file>

    </properties>

    <!-- ============================================================ -->
    <!--  Dependencies                                                -->
    <!-- ============================================================ -->
    <dependencies>

        <!-- ======================================================== -->
        <!--  SELENIUM                                                 -->
        <!-- ======================================================== -->

        <!-- Full Selenium Java binding (Chrome, Firefox, Edge, etc.) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Explicit: Page Factory, Select, FluentWait, ExpectedConditions -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Chrome DevTools Protocol (CDP) support -->
        <!-- ======================================================== -->
        <!--  WEBDRIVER MANAGER                                        -->
        <!-- ======================================================== -->

        <!-- Auto-manages browser driver binaries (no PATH setup needed) -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  TESTNG                                                   -->
        <!-- ======================================================== -->

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  ALLURE REPORTS                                           -->
        <!-- ======================================================== -->

        <!-- Allure + TestNG integration -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Allure annotations: @Step, @Epic, @Feature, @Story, etc. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Allure attachments support -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-attachments</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  EXTENT REPORTS (secondary HTML report)                  -->
        <!-- ======================================================== -->

        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  EXCEL DATA-DRIVEN — Apache POI                          -->
        <!-- ======================================================== -->

        <!-- Core POI — handles .xls (HSSF) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${apache.poi.version}</version>
        </dependency>

        <!-- POI OOXML — handles .xlsx (XSSF) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${apache.poi.version}</version>
        </dependency>

        <!-- POI OOXML Schemas (required by poi-ooxml) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml-lite</artifactId>
            <version>${apache.poi.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  JSON DATA-DRIVEN — Jackson                               -->
        <!-- ======================================================== -->

        <!-- Jackson core — low-level JSON streaming -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Jackson annotations — @JsonProperty, @JsonIgnore, etc. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Jackson databind — ObjectMapper, TypeReference -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Jackson datatype — Java 8 date/time support -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Gson (alternative lightweight JSON parser) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  CONFIG READER — Owner Library                            -->
        <!-- ======================================================== -->

        <!-- Type-safe .properties config binding -->
        <dependency>
            <groupId>org.aeonbits.owner</groupId>
            <artifactId>owner</artifactId>
            <version>${owner.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  LOGGING — Log4j2 + SLF4J                                -->
        <!-- ======================================================== -->

        <!-- Log4j2 API -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- Log4j2 implementation -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- Bridge SLF4J → Log4j2 (many libraries use SLF4J) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  LOMBOK — Boilerplate Reduction                           -->
        <!-- ======================================================== -->

        <!-- @Data, @Builder, @Getter, @Setter for model classes -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ======================================================== -->
        <!--  APACHE COMMONS                                           -->
        <!-- ======================================================== -->

        <!-- File copy, read, delete operations for screenshots -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons.io.version}</version>
        </dependency>

        <!-- String utils, RandomStringUtils, DateUtils -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons.lang3.version}</version>
        </dependency>

        <!-- Base64 encoding for screenshots -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>${commons.codec.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  ASPECTJ — Required by Allure for @Step weaving          -->
        <!-- ======================================================== -->

        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
        </dependency>

        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjrt</artifactId>
            <version>${aspectj.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  JAVA FAKER — Random Test Data Generation                 -->
        <!-- ======================================================== -->

        <!-- Generates realistic fake names, emails, addresses, etc. -->
        <dependency>
            <groupId>com.github.javafaker</groupId>
            <artifactId>javafaker</artifactId>
            <version>${faker.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  ASSERTJ — Fluent Assertions                              -->
        <!-- ======================================================== -->

        <!-- More readable assertions than TestNG's Assert -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <!-- ======================================================== -->
        <!--  REST ASSURED — API Testing (for setup/teardown via API)  -->
        <!-- ======================================================== -->

        <!-- Create test users, orders, reset state via API -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest.assured.version}</version>
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
            <version>${rest.assured.version}</version>
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>xml-path</artifactId>
            <version>${rest.assured.version}</version>
        </dependency>

    </dependencies>

    <!-- ============================================================ -->
    <!--  Build Configuration                                         -->
    <!-- ============================================================ -->
    <build>

        <!-- Allow filtering of config files (inject Maven properties) -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                    <!-- Lombok annotation processor -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>

                    <!-- TestNG suite file — switchable via -Dsuite.file -->
                    <suiteXmlFiles>
                        <suiteXmlFile>
                            src/test/resources/config/${suite.file}
                        </suiteXmlFile>
                    </suiteXmlFiles>

                    <!-- AspectJ agent — REQUIRED for Allure @Step weaving -->
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                        -Xmx1024m
                        -Dfile.encoding=UTF-8
                    </argLine>

                    <!-- Pass runtime properties into tests -->
                    <systemPropertyVariables>
                        <browser>${browser}</browser>
                        <env>${env}</env>
                        <headless>${headless}</headless>
                        <thread.count>${thread.count}</thread.count>
                        <allure.results.directory>
                            ${project.build.directory}/allure-results
                        </allure.results.directory>
                    </systemPropertyVariables>

                    <!-- Keep going after test failures (collect all results) -->
                    <testFailureIgnore>false</testFailureIgnore>

                    <!-- Show full test output in console -->
                    <useFile>false</useFile>
                    <disableXmlReport>false</disableXmlReport>

                    <!-- Fail build if no tests run -->
                    <failIfNoTests>false</failIfNoTests>

                </configuration>

                <!-- Inject aspectjweaver as agent dependency -->
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>

            </plugin>

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.version}</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>
                        ${project.build.directory}/allure-results
                    </resultsDirectory>
                    <reportDirectory>
                        ${project.build.directory}/allure-report
                    </reportDirectory>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven.resources.plugin.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- ============================================================ -->
    <!--  Profiles — switch suites and environments from CLI          -->
    <!-- ============================================================ -->
    <profiles>

        <!-- mvn clean test -Psmoke -->
        <profile>
            <id>smoke</id>
            <properties>
                <suite.file>testng-smoke.xml</suite.file>
            </properties>
        </profile>

        <!-- mvn clean test -Pregression -->
        <profile>
            <id>regression</id>
            <properties>
                <suite.file>testng-regression.xml</suite.file>
            </properties>
        </profile>

        <!-- mvn clean test -Pe2e -->
        <profile>
            <id>e2e</id>
            <properties>
                <suite.file>testng-e2e.xml</suite.file>
            </properties>
        </profile>

        <!-- mvn clean test -Pparallel -Dthread.count=4 -->
        <profile>
            <id>parallel</id>
            <properties>
                <suite.file>testng-parallel.xml</suite.file>
                <thread.count>4</thread.count>
            </properties>
        </profile>

        <!-- mvn clean test -Pdev -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <env>dev</env>
            </properties>
        </profile>

        <!-- mvn clean test -Pstaging -->
        <profile>
            <id>staging</id>
            <properties>
                <env>staging</env>
            </properties>
        </profile>

        <!-- mvn clean test -Pprod -->
        <profile>
            <id>prod</id>
            <properties>
                <env>prod</env>
            </properties>
        </profile>

        <!-- mvn clean test -Pheadless -->
        <profile>
            <id>headless</id>
            <properties>
                <headless>true</headless>
            </properties>
        </profile>

        <!-- mvn clean test -Pchrome -->
        <profile>
            <id>chrome</id>
            <properties>
                <browser>chrome</browser>
            </properties>
        </profile>

        <!-- mvn clean test -Pfirefox -->
        <profile>
            <id>firefox</id>
            <properties>
                <browser>firefox</browser>
            </properties>
        </profile>

        <!-- mvn clean test -Pedge -->
        <profile>
            <id>edge</id>
            <properties>
                <browser>edge</browser>
            </properties>
        </profile>

    </profiles>

    <!-- ============================================================ -->
    <!--  Reporting                                                   -->
    <!-- ============================================================ -->
    <reporting>
        <plugins>
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.version}</version>
            </plugin>
        </plugins>
    </reporting>

</project>